# ==============================================================================
# ShareBite Server Environment Variables
# Copy this file to .env before starting the server
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# CORS Configuration (Client Origins)
# Supports comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# ==============================================================================
# FIREBASE & FIRESTORE INTEGRATION (ASSIGNED TO TEAMMATE 2: Database & Firebase)
# ==============================================================================
# Step 1: In Firebase Console -> Project Settings -> Service Accounts
# Step 2: Click "Generate new private key"
# Step 3: Either place serviceAccountKey.json in server/src/config/ or fill below:
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/serviceAccountKey.json
FIREBASE_PROJECT_ID=sharebite-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@sharebite-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://sharebite-dev.firebaseio.com

# Mock Auth Fallback (Set to true to test API without Firebase credentials)
MOCK_AUTH_ENABLED=true
