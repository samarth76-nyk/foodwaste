# ==============================================================================
# ShareBite Frontend Environment Variables
# Copy to .env in client directory
# ==============================================================================

# API Base URL (relative '/api' when using Vite dev proxy, or full URL)
VITE_API_BASE_URL=/api

# Target backend server URL for Vite proxy
VITE_BACKEND_URL=http://localhost:5000

# Firebase Client Configuration
# Needed if initializing client-side Firebase Auth SDK
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=sharebite-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sharebite-demo
VITE_FIREBASE_STORAGE_BUCKET=sharebite-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456
